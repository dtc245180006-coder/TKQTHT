POSTGRES_DB=hotel_booking_db
POSTGRES_USER=hotel_admin
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Operator ports are fixed to 127.0.0.1. Use an SSH tunnel/VPN for remote operations.
SECRETS_DIR=./secrets/local

# Staff accounts are created only if their usernames do not exist yet.
SESSION_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Set true after enabling HTTPS. Keep false for local HTTP demos.
SESSION_COOKIE_SECURE=false
# Public requests await staff approval; never extend this deadline when retrying.
BOOKING_HOLD_MINUTES=120
STAFF_ADMIN_USERNAME=admin
STAFF_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
STAFF_RECEPTION_USERNAME=letan
STAFF_RECEPTION_PASSWORD=CHANGE_ME_RECEPTION_PASSWORD
# Only set true for an isolated demo installation; existing rows are never removed.
SEED_DEMO_DATA=false
