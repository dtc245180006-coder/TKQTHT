<section id="financeRequestSection">
  <h4>Yêu cầu sửa sai / thanh toán sau trả phòng</h4>
  <p class="muted"><%= currentUser.role==='admin'?'Quản trị thực hiện trực tiếp sau khi đối chiếu và xác nhận mật khẩu.':'Lễ tân lập yêu cầu; sổ chưa đổi cho đến khi quản trị duyệt.' %> Sửa sai ghi bút toán đảo và phiếu thay thế, không sửa phiếu cũ.</p>
  <div class="form-row">
    <div class="form-group"><label for="financeAction">Loại yêu cầu</label><select id="financeAction"><option value="correct">Sửa sai phiếu đã ghi</option><option value="post_refund">Hoàn/giảm tiền sau trả phòng</option><option value="post_payment">Thu công nợ sau trả phòng</option></select></div>
    <div class="form-group" id="financeTargetField"><label for="financePaymentId">Phiếu cần sửa</label><select id="financePaymentId"></select></div>
  </div>
  <div class="form-row"><div class="form-group"><label for="financeAmount">Số tiền đúng / số tiền hoàn, thu bổ sung</label><input id="financeAmount" type="number" min="0" step="0.01"><small>Với sửa sai: nhập 0 để đảo toàn bộ phiếu không có thực; số tiền dương tạo phiếu thay thế.</small></div>
    <div class="form-group"><label for="financeMethod">Phương thức đúng</label><select id="financeMethod"><option value="cash">Tiền mặt</option><option value="bank_transfer">Chuyển khoản</option><option value="wallet">Ví điện tử</option></select></div></div>
  <div class="form-group"><label for="financeReference">Mã tham chiếu đúng (bắt buộc với chuyển khoản/ví)</label><input id="financeReference" maxlength="200" placeholder="Ví dụ MoMo:mã giao dịch"></div>
  <div class="form-group"><label for="financeReason">Lý do và căn cứ đối chiếu</label><input id="financeReason" minlength="5" maxlength="500"></div>
  <% if(currentUser.role==='admin'){ %>
  <div class="form-group"><label for="financePassword">Mật khẩu hiện tại của quản trị</label><input id="financePassword" type="password" autocomplete="current-password"></div>
  <label><input id="financeConfirmed" type="checkbox"> Đã đối chiếu chứng từ/tiền thực tế. Bút toán sửa sổ không tự chuyển tiền.</label>
  <% } %>
  <button id="submitFinanceRequest" class="btn btn-outline" type="button"><%= currentUser.role==='admin'?'Xác nhận và ghi điều chỉnh':'Gửi yêu cầu quản trị duyệt' %></button>
  <ul id="bookingFinanceRequests" class="stay-events"></ul>
</section>
