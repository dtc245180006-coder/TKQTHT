  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title %> | Aurora Haven</title>
  <link rel="stylesheet" href="/css/base.css?v=original-navy-2">
  <link rel="stylesheet" href="/css/layout.css?v=original-navy-2">
